# SellFuse API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-characters
AI_GATEWAY_BASE_URL=http://localhost:8787
AI_GATEWAY_TOKEN=replace-with-a-long-internal-service-token

# Optional licensed/private market-data service (configure all three together)
MARKET_DATA_BASE_URL=
MARKET_DATA_TOKEN=
MARKET_DATA_ALLOWED_SOURCES=

# Nader AI Gateway (server-side only)
AI_GATEWAY_PORT=8787
AI_GATEWAY_HOST=127.0.0.1
AI_PROVIDER=self_hosted
AI_RUNTIME=ollama
AI_BASE_URL=http://localhost:11434
AI_TEXT_MODEL=qwen3:8b
AI_VISION_MODEL=gemma3:4b
AI_EMBEDDING_MODEL=embeddinggemma
AI_RUNTIME_TOKEN=
AI_REQUEST_TIMEOUT_MS=45000
AI_MAX_CONCURRENCY=2
AI_MAX_IMAGES=8
AI_MAX_IMAGE_BYTES=8388608

# Web/mobile public configuration (never put gateway secrets here)
NEXT_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# Production persistence boundary
DATABASE_URL=postgresql://sellfuse:sellfuse@localhost:5432/sellfuse
